model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["finance dim_customer","finance dim_toll_band","finance dim_vessel","finance dim_week","finance fact_ar_snapshot","finance fact_invoice","finance fact_payment","finance kpi_customer_13w","finance kpi_overdue_list","finance kpi_weekly","finance kpi_weekly_category"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table Customer
ref table 'Toll Band'
ref table Vessel
ref table Week
ref table 'AR Snapshot'
ref table Invoices
ref table Payments
ref table 'Customer KPIs 13w'
ref table 'Overdue List'
ref table 'Weekly KPIs'
ref table 'Category KPIs'
ref table 'Weekly Trend'

ref cultureInfo en-US

