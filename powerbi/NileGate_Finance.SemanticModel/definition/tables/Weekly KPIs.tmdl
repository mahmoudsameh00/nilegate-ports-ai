	partition 'finance kpi_weekly' = m
		mode: directQuery
		source =
				let
				  Source = PostgreSQL.Database("127.0.0.1:5432", "ports_logistics"),
				  #"Navigation 1" = Source{[Schema = "finance", Item = "kpi_weekly"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

