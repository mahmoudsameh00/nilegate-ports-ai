# Copy to .env (git-ignored) and fill in the values. Never commit .env. (ADR-015, ADR-027)

# PostgreSQL / PostGIS — container ports-postgres
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# read-only login user (joins ports_readonly, ADR-034); created and filled by db\create_readonly_user.ps1
PG_RO_USER=
PG_RO_PASSWORD=

# MongoDB 8.0 — container ports-mongo (bound to 127.0.0.1 only)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=ports_logistics
MONGO_AUTH_SOURCE=admin
# root: administration only (container init, creating users); never used by notebooks
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
# application user: readWrite on MONGO_DB only; used by the loader notebook
MONGO_APP_USER=
MONGO_APP_PASSWORD=
