# Copy to .env and fill in the values. .env is git-ignored; never commit real values.
# Read by pipelines/lib/common.load_env (variables already set in the environment win).

# PostgreSQL (container ports-postgres): owner account for migrations / ETL, read-only account for retrieval and agents
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PG_RO_USER=
PG_RO_PASSWORD=
# Power BI login (member of finance_bi: SELECT on schema finance only; ADR-047), written by db/create_finance_bi_user.ps1
PG_BI_USER=
PG_BI_PASSWORD=

# MongoDB (container ports-mongo): root only through db/mongo/run.ps1, the app user for scripts
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
MONGO_AUTH_SOURCE=
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# Qdrant (container ports-qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Embeddings / reranker (ADR-037, ADR-038); VOYAGE is a bake-off candidate only
GEMINI_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=
# Uploads approval gate (ADR-044): "paid" lets any uploaded document be promoted; set by the owner for this
# educational project, whose data is synthetic or public (ADR-037 amendment 2)
GEMINI_TIER=paid

# LLMs on free APIs (Agents plan §7a); a missing key = that provider is skipped
GROQ_API_KEY=
OPENROUTER_API_KEY=

# News search for the agents' web_search tool (Agents plan Phase 4, ADR-011; Tavily free plan, app.tavily.com);
# missing = the tool answers "context unavailable"
TAVILY_API_KEY=

# Later phases: LangSmith tracing (Phase 8)
LANGCHAIN_API_KEY=
