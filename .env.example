# Copy to .env and fill in the values. .env is git-ignored; never commit real values.
# Read by pipelines/lib/common.load_env (variables already set in the environment win).

# PostgreSQL (container ports-postgres): owner account for migrations / ETL, read-only account for retrieval and agents
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PG_RO_USER=
PG_RO_PASSWORD=

# MongoDB (container ports-mongo): root only through db/mongo/run.ps1, the app user for scripts
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
MONGO_AUTH_SOURCE=
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# Qdrant (container ports-qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Embeddings / reranker (ADR-037, ADR-038); VOYAGE is a bake-off candidate only
GEMINI_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=
# Optional: set to "paid" only when the Gemini key is on a paid tier (ADR-037 data policy); default free
# GEMINI_TIER=

# LLMs on free APIs (Agents plan §7a); a missing key = that provider is skipped
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Later phases: LangSmith tracing (Phase 8)
LANGCHAIN_API_KEY=
