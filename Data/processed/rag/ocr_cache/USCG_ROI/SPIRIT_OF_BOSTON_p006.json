   "retry": null
  },
  {
   "bbox": [
    70.1,
    403.2,
    347.8,
    418.4
   ],
   "text": "prioritized fighting the fire over evacuation of the vessel.",
   "conf": 0.9921,
   "retry": null
  },
  {
   "bbox": [
    71.3,
    429.5,
    538.3,
    442.7
   ],
   "text": "The findings of fact and recommendations are approved subject to the following comments. It is",
