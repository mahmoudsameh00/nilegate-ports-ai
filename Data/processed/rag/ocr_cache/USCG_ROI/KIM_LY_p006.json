  {
   "bbox": [
    71.7,
    415.6,
    520.0,
    432.3
   ],
   "text": "Safety Recommendation: Recommend that the Commandant of the Coast Guard amend the",
   "conf": 0.9958,
   "retry": null
  },
  {
   "bbox": [
    71.7,
    429.1,
    515.2,
    447.1
   ],
   "text": "applicability of 46 CFR § 28.200 to include commercial fishing vessels operating inside the",
