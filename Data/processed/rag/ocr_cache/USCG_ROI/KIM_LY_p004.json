   "retry": null
  },
  {
   "bbox": [
    70.5,
    362.1,
    533.5,
    376.8
   ],
   "text": "1. The loss of life was a tragic, yet preventable accident. I offer my sincerest condolences to the",
   "conf": 0.9996,
   "retry": null
  },
  {
   "bbox": [
    70.9,
    376.8,
