   "retry": null
  },
  {
   "bbox": [
    71.3,
    570.4,
    276.9,
    583.6
   ],
   "text": "engaged in nearshore or inland operations.",
   "conf": 0.9999,
   "retry": null
  },
  {
   "bbox": [
    71.3,
    598.0,
    532.3,
    611.2
   ],
   "text": "The investigation identified that unguarded machinery, specifically winches, posed a direct risk",
   "conf": 0.9994,
   "retry": null
  },
  {
   "bbox": [
    70.9,
    611.6,
    521.2,
    624.7
   ],
   "text": "of serious injury or death to crewmembers, regardless of operating location. According to the",
   "conf": 0.9945,
   "retry": null
  },
  {
   "bbox": [
    70.5,
    624.7,
    533.1,
    638.7
   ],
   "text": "Centers for Disease Control and Prevention (CDC) article Fatal and Nonfatal Injuries Involving",
