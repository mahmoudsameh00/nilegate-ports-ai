   "retry": null
  },
  {
   "bbox": [
    71.3,
    515.4,
    528.3,
    526.9
   ],
   "text": "Safety Recommendation 1: Recommend that the Commandant of the Coast Guard amend the",
   "conf": 0.9949,
   "retry": null
  },
  {
   "bbox": [
    70.5,
    527.7,
    514.0,
    542.5
   ],
   "text": "applicability of 46 CFR § 28.200 to include commercial fishing vessels operating inside the",
   "conf": 0.989,
   "retry": null
  },
  {
   "bbox": [
    71.3,
    542.9,
    530.3,
    554.9
   ],
   "text": "boundary line. Currently, the regulation requires suitable guards or covers for rotary machinery",
   "conf": 0.9932,
   "retry": null
  },
  {
   "bbox": [
    71.3,
    556.5,
    537.1,
    569.6
   ],
   "text": "only on vessels operating beyond the boundary line, leaving a gap in safety standards for vessels",
