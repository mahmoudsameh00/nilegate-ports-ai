# Virtual environment
.venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Python cache
__pycache__/
*.py[cod]

# Raw / large datasets
Data/raw/

# Temporary files
*.tmp
*.log

Notebooks/_scratch/
Data/processed/semi-structured/synthetic/*.parquet

# Embedding vectors (ADR-037, owner 2026-10-05): only manifest.json is committed; it carries the hashes that prove
# a local dense.parquet matches. The working cache of the embedding script is local too.
Data/embeddings/*/dense*.parquet
Data/embeddings/*/cache_*/

# Local embedding models (RAG plan Phase 8): downloaded / exported weights, rebuilt by tools/export_onnx.py
models/
# Promotion requests of uploaded documents (persisted only on a manager's explicit request; reviewed offline)
Data/incoming/
